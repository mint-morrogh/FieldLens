# Required for live plant identification (server-side only — never prefix with VITE_)
# Get a free key at https://my.plantnet.org/
PLANTNET_API_KEY=

# Application name reported by /api/health (the visible UI name lives in src/config/brand.ts)
APP_NAME=FieldLens

# Development: serve fixture data instead of calling Pl@ntNet / GBIF / iNaturalist
USE_MOCK_API=false

# Optional: Pl@ntNet flora project (default "all")
# PLANTNET_PROJECT=all

# Non-plant identification (BioCLIP 2 on our Hugging Face Space). Server-side only.
# HF_TOKEN: a READ-only Hugging Face token (the Space is private).
# HF_TOKEN=
# BIOCLIP_SPACE_URL=https://mintmundane-fieldlens-bioclip.hf.space

# Species range index (iNaturalist Open Range Map Dataset): a private HF dataset read with
# HF_TOKEN. Built and uploaded by scripts/build-range-shards.py. Defaults to the one below.
# RANGES_DATASET=mintmundane/fieldlens-ranges

# Optional: recent bird sightings near the user, for seasonal evidence. Server-side only.
# Free for non-commercial use: https://ebird.org/api/keygen
# EBIRD_API_KEY=

# Only for redeploying hf-space/ with `npm run space:deploy` (a WRITE token). Never set in Vercel.
# HF_DEPLOY_TOKEN=
# HF_SPACE_REPO=mintmundane/fieldlens-bioclip
