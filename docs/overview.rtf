\f1\b0\fs24 \cf0 Create typed provider interfaces.\
Example:\
\pard\pardeftab720\partightenfactor0

\f0\fs26 \cf0 type OrganismCategory =\
  | "plant"\
  | "bird"\
  | "mammal"\
  | "reptile"\
  | "amphibian"\
  | "fish"\
  | "insect"\
  | "arachnid"\
  | "fungus"\
  | "other";\
\
interface IdentificationProvider \{\
  supports(category: OrganismCategory): boolean;\
\
  identify(\
    input: IdentificationInput\
  ): Promise<IdentificationResult>;\
\}\
\
interface OccurrenceProvider \{\
  getOccurrenceEvidence(\
    taxon: TaxonIdentity,\
    location: ApproxLocation,\
    date: Date\
  ): Promise<OccurrenceEvidence>;\
\}\
\
